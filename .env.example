# Local development only. Use plain values (without quotes) for Spring .properties compatibility.
DB_HOST=localhost
DB_PORT=3306
MYSQL_DATABASE=doanchuyennganh
MYSQL_USER=app
MYSQL_PASSWORD=local_password
MYSQL_ROOT_PASSWORD=local_root_password

# Opt-in local sample accounts. Replace empty placeholders before enabling.
APP_SEED_ENABLED=false
SEED_STUDENT_PASSWORD=test1234
SEED_TEACHER_PASSWORD=test1234
SEED_ADMIN_PASSWORD=test1234

# Host ports for the full Docker stack (container ports stay fixed).
BACKEND_PORT=8080
FRONTEND_PORT=8088
